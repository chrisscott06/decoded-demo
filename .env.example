# Brief 27 (NZA 26003-EPC-01) - .env template.
#
# Copy this file to .env (which IS .gitignored) and fill in real values
# if/when the legacy EPC API resurrects. Without these, the probe runs
# unauthenticated - which is enough to detect retirement (HTML 301 ->
# GOV.UK One Login) but cannot exercise the legacy authenticated path.
#
# As of 8 Jun 2026, legacy is RETIRED. The probe correctly classifies
# this without auth, and the parse step reads manually-downloaded
# One Login bulk ZIPs from pipeline/source-data/epc/raw/. No real .env
# is needed to run the Phase 1 pipeline.

EPC_EMAIL=
EPC_API_KEY=
